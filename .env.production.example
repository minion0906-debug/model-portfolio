# Database
DATABASE_URL="postgresql://user:password@host:5432/model_portfolio"

# Admin session signing
AUTH_SECRET="replace-with-a-long-random-secret"

# S3-compatible object storage
# Works with AWS S3, Cloudflare R2, MinIO and compatible providers.
MEDIA_STORAGE="s3"
S3_BUCKET="model-portfolio"
S3_REGION="auto"
S3_ENDPOINT="https://YOUR-ENDPOINT"
S3_ACCESS_KEY_ID="replace-me"
S3_SECRET_ACCESS_KEY="replace-me"
S3_PUBLIC_URL="https://cdn.example.com"
S3_FORCE_PATH_STYLE="false"
