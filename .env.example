DATABASE_URL="postgresql://postgres:password@localhost:5432/model_portfolio"

# PayPal
# Use sandbox credentials while developing.
PAYPAL_ENVIRONMENT="sandbox"
PAYPAL_CLIENT_ID="YOUR_PAYPAL_SANDBOX_CLIENT_ID"
PAYPAL_CLIENT_SECRET="YOUR_PAYPAL_SANDBOX_CLIENT_SECRET"

# Webhook ID from your PayPal Developer App webhook configuration.
PAYPAL_WEBHOOK_ID="YOUR_PAYPAL_WEBHOOK_ID"

# Generate a strong random value for production.
# Example:
# openssl rand -hex 32
AUTH_SECRET="replace-with-a-long-random-secret"

# Development/admin bootstrap credentials.
# Change these before using the site publicly.
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="ChangeMe123!"
